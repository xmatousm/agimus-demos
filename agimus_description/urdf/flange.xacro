<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find agimus_description)/urdf/_materials.urdf.xacro" />

  <xacro:macro name="tool_flange" params="parent name:=flange">

  <joint name="${name}_joint" type="fixed">
    <origin xyz="0 0 0.01" rpy="0 0 0"/>
    <parent link="${parent}"/>
    <child link="${name}" />
  </joint>

  <link name="${name}">
    <visual>
      <geometry>
        <cylinder length="0.01" radius="0.065"/>
      </geometry>
      <material name="steel"/>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
    </visual>
  </link>
  </xacro:macro>
</robot>
